PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# `docker compose up -d` from the repo root starts this database
DATABASE_URL=postgres://freelance:freelance@localhost:5434/freelance?sslmode=disable
UPLOAD_DIR=uploads
# Comma-separated emails allowed to resolve disputes (the platform arbiter)
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Escrow rules (mirror the contract): fee in basis points, auto-claim and refund windows in days
FEE_BPS=200
CLAIM_AFTER_DAYS=7
REFUND_AFTER_DAYS=14

# --- On-chain escrow (leave empty to run in off-chain preview mode) ---
# `npm run dev:chain` passes these to the API for you against a local chain, without editing this file.
ESCROW_ADDRESS=
CHAIN_ID=
RPC_URL=
